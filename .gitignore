:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #1b1b1f;
  background: #f7f1ec;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(244, 195, 125, 0.15), transparent 35%),
    #f4efe9;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  width: 100%;
}

#root {
  min-height: 100vh;
}

.page-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px 24px 56px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 20px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(27, 27, 31, 0.06);
  border-radius: 24px;
  position: sticky;
  top: 16px;
  z-index: 30;
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #ff9f6f, #d56539);
  color: white;
  font-weight: 700;
  font-size: 1.3rem;
}

.logo-text,
.logo-sub {
  margin: 0;
  line-height: 1;
}

.logo-text {
  font-size: 1.15rem;
  font-weight: 700;
}

.logo-sub {
  font-size: 0.74rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  opacity: 0.72;
}

.nav {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 0.96rem;
  color: rgba(27, 27, 31, 0.8);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.primary-btn,
.ghost-btn,
.filter-pill,
.icon-btn {
  border: none;
  border-radius: 999px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, #201c1a, #4b2a20);
  color: white;
  padding: 12px 18px;
  font-weight: 600;
  box-shadow: 0 14px 24px rgba(53, 31, 22, 0.18);
}

.ghost-btn {
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(27, 27, 31, 0.08);
  padding: 11px 18px;
  font-weight: 600;
}

.primary-btn:hover,
.ghost-btn:hover,
.filter-pill:hover,
.icon-btn:hover {
  transform: translateY(-1px);
}

.large-btn {
  padding: 14px 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 48px;
  padding: 72px 8px 48px;
}

.eyebrow {
  margin: 0 0 14px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #af5d35;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.99;
  letter-spacing: -0.05em;
}

.subtitle {
  max-width: 620px;
  margin-top: 18px;
  font-size: 1.05rem;
  color: rgba(27, 27, 31, 0.72);
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.trust-row {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  margin-top: 32px;
}

.trust-row div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.trust-row strong {
  font-size: 1.7rem;
}

.trust-row span {
  color: rgba(27, 27, 31, 0.7);
  font-size: 0.92rem;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.hero-card {
  position: relative;
  border-radius: 32px;
  overflow: hidden;
  box-shadow: 0 26px 54px rgba(30, 18, 12, 0.14);
}

.large-card {
  width: min(100%, 540px);
}

.hero-card img {
  height: 640px;
  object-fit: cover;
}

.floating-box {
  position: absolute;
  left: 24px;
  bottom: 24px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 18px 20px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.87);
  border: 1px solid rgba(27, 27, 31, 0.08);
}

.floating-box span {
  color: rgba(27, 27, 31, 0.7);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.floating-box strong {
  font-size: 1.35rem;
}

.collection-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-top: 14px;
}

.collection-card {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 200px;
  padding: 22px;
  border-radius: 28px;
  color: white;
  background: linear-gradient(135deg, rgba(42, 28, 24, 0.72), rgba(125, 75, 49, 0.78)),
    url('https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=1200&q=80') center/cover;
  box-shadow: 0 18px 30px rgba(42, 28, 24, 0.14);
}

.collection-card span {
  font-size: 0.82rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.8;
}

.collection-card strong {
  font-size: 1.7rem;
  margin-top: 10px;
}

.shop-panel {
  padding-top: 64px;
}

.shop-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.shop-header h2,
.section-head h2 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.04em;
}

.shop-controls {
  min-width: min(100%, 320px);
}

.shop-controls input,
.product-form input,
.product-form select,
.product-form textarea {
  width: 100%;
  border: 1px solid rgba(27, 27, 31, 0.12);
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14px;
  padding: 12px 14px;
  color: #1b1b1f;
}

.filter-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}

.filter-pill {
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(27, 27, 31, 0.08);
  padding: 10px 16px;
  font-weight: 600;
  color: rgba(27, 27, 31, 0.8);
}

.filter-pill.active {
  background: #201c1a;
  color: white;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}

.product-card {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(27, 27, 31, 0.06);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 14px 28px rgba(31, 21, 17, 0.06);
}

.product-image-wrap {
  position: relative;
}

.product-image-wrap img {
  height: 280px;
  object-fit: cover;
}

.product-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.74rem;
  font-weight: 700;
}

.product-body {
  padding: 18px 18px 12px;
}

.product-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(27, 27, 31, 0.7);
}

.product-body h3 {
  margin: 12px 0 10px;
  font-size: 1.4rem;
  letter-spacing: -0.04em;
}

.product-body p {
  margin: 0;
  color: rgba(27, 27, 31, 0.75);
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 16px 18px 18px;
}

.product-footer strong {
  display: block;
  font-size: 1.3rem;
}

.product-footer small {
  color: rgba(27, 27, 31, 0.62);
}

.admin-panel {
  margin-top: 58px;
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(27, 27, 31, 0.06);
  border-radius: 32px;
  padding: 28px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 24px;
}

.product-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.product-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-weight: 600;
  color: rgba(27, 27, 31, 0.85);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: min(100%, 420px);
  height: 100vh;
  background: rgba(255, 255, 255, 0.96);
  border-left: 1px solid rgba(27, 27, 31, 0.08);
  box-shadow: -18px 0 26px rgba(21, 19, 18, 0.08);
  transform: translateX(110%);
  transition: transform 0.24s ease;
  z-index: 50;
  display: flex;
  flex-direction: column;
}

.cart-drawer.open {
  transform: translateX(0);
}

.cart-header,
.cart-summary,
.empty-cart {
  padding: 22px 20px;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(27, 27, 31, 0.07);
}

.cart-header h3 {
  margin: 0;
  font-size: 1.5rem;
}

.icon-btn {
  width: 40px;
  height: 40px;
  background: rgba(27, 27, 31, 0.06);
  font-size: 1.4rem;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.cart-item {
  display: flex;
  gap: 14px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(27, 27, 31, 0.06);
}

.cart-item img {
  width: 86px;
  height: 86px;
  border-radius: 16px;
  object-fit: cover;
}

.cart-item-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.qty-control {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  width: fit-content;
  border: 1px solid rgba(27, 27, 31, 0.12);
  border-radius: 999px;
  padding: 6px 10px;
}

.qty-control button {
  width: 24px;
  height: 24px;
  border: none;
  border-radius: 999px;
  background: rgba(27, 27, 31, 0.08);
}

.cart-summary {
  border-top: 1px solid rgba(27, 27, 31, 0.07);
  background: rgba(249, 245, 241, 0.9);
}

.cart-summary div {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

.total-row {
  padding-top: 8px;
  border-top: 1px dashed rgba(27, 27, 31, 0.18);
  margin-top: 14px;
}

.checkout-btn {
  width: 100%;
  margin-top: 12px;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 18px;
  flex: 1;
  text-align: center;
  color: rgba(27, 27, 31, 0.75);
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  margin-top: 56px;
  padding-top: 24px;
  border-top: 1px solid rgba(27, 27, 31, 0.08);
  color: rgba(27, 27, 31, 0.72);
}

@media (max-width: 1100px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .collection-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 850px) {
  .topbar,
  .nav,
  .topbar-actions,
  .shop-header,
  .footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 52px;
  }

  .hero-card img {
    height: 440px;
  }

  .product-grid,
  .field-grid,
  .collection-grid {
    grid-template-columns: 1fr;
  }

  .shop-controls {
    width: 100%;
  }
}

@media (max-width: 560px) {
  .page-shell {
    padding-left: 16px;
    padding-right: 16px;
  }

  .topbar {
    padding: 14px 16px;
  }

  .nav {
    gap: 12px;
    font-size: 0.88rem;
  }

  .topbar-actions {
    width: 100%;
  }

  .topbar-actions .primary-btn,
  .topbar-actions .ghost-btn {
    width: 100%;
  }
}
